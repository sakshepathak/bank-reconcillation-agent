 Permissions mode on this machine. The session has been switched to Accept Edits — send your message again to continue.",id:"u+b+OpBo2Z"},otelExporter:{defaultMessage:"An OTEL console exporter in settings.json is interfering with Claude Code. Remove the OTEL_*_EXPORTER=console setting.",id:"lY2D3mXwpE"},bridgeOffline:{defaultMessage:"Your terminal's Claude Code session stopped responding. Check your terminal for errors, then resend your message.",id:"zaPxGqzW4A"},sshDisconnected:{defaultMessage:"The SSH connection dropped and auto-reconnect didn't succeed. Your session is preserved on the remote host — resend your message to reconnect and pick up where you left off. If it keeps failing, check that the host is reachable (VPN, network) and your SSH agent is unlocked.",id:"RtSXJpna/C"},rewindTargetNotFound:{defaultMessage:"That point in the conversation couldn't be found. Send your message again to continue the session.",id:"pPg+NzFStg"},gitCheckoutFailed:{defaultMessage:"Commit or stash changes, or check your repository for issues like a missing branch, locked files, or Git LFS setup.",id:"nZAVyUccg2"},remoteWorktreeFailed:{defaultMessage:"Check disk space and the repository on that machine, then try again.",id:"sThS3jTs5d"},policyDenied:{defaultMessage:"Your organization's policy has blocked access to this folder. Choose a folder inside an allowed workspace, or contact your IT team.",id:"/zBewcOy3f"},binaryLocked:{defaultMessage:"Another program (e.g. antivirus) has a temporary lock on app files. Wait a moment and try again.",id:"4w2mdIEQf/"}}),uIt={sdk_binary_missing:{title:cIt.cliCouldntStart,body:dIt.reinstall,retryHelps:!1},sdk_binary_arch_mismatch:{title:cIt.cliCouldntStart,body:dIt.reinstallArch,retryHelps:!1},sdk_binary_corrupt:{title:cIt.cliCouldntStart,body:dIt.tryAgain,retryHelps:!0},disclaimer_binary_missing:{title:cIt.cliCouldntStart,body:dIt.reinstall,retryHelps:!1},spawn_failed:{title:cIt.cliCouldntStart,body:dIt.restartApp,retryHelps:!0},segfault:{title:cIt.cliCrashed,body:dIt.tryAgainOrReport,retryHelps:!0},process_crashed:{title:cIt.cliCrashed,body:dIt.tryAgainOrReport,retryHelps:!0},renderer_cascade:{title:cIt.interrupted,body:dIt.tryAgain,retryHelps:!0},process_interrupted:{title:cIt.interrupted,body:dIt.tryAgain,retryHelps:!0},endpoint_security_blocked:{title:cIt.endpointSecurity,body:dIt.endpointSecurity,retryHelps:!1},app_control_blocked:{title:cIt.appControlBlocked,body:dIt.appControlBlocked,retryHelps:!1,copyDetails:'Claude\'s workspace runtime failed to start with errno -4094 (spawn UNKNOWN).\n\nThis is usually WDAC, AppLocker, or antivirus/endpoint protection blocking execution of the runtime binary, which is downloaded under the user profile:\n\n  %LOCALAPPDATA%\\Claude-3p\\claude-code\\<version>\\claude.exe   (third-party deployment)\n  %APPDATA%\\Claude\\claude-code\\<version>\\claude.exe           (standard deployment)\n\nThe runtime also spawns ripgrep (rg.exe) from the same directory.\n\nTo confirm which control is blocking it, check Event Viewer:\n  - WDAC:       Applications and Services Logs > Microsoft > Windows > CodeIntegrity > Operational, Event ID 3077\n  - AppLocker:  Applications and Services Logs > Microsoft > Windows > AppLocker > EXE and DLL, Event ID 8004\n  - Defender:   Applications and Services Logs > Microsoft > Windows > Windows Defender > Operational, Event ID 1116 / 1117\n\nTo fix, add a publisher rule for "Anthropic, PBC" to the WDAC or AppLocker policy applied to this device. The binary is code-signed (verify with: Get-AuthenticodeSignature on claude.exe), so a publisher rule covers all install modes and version updates.\n\nIf publisher rules aren\'t available, add a path rule instead:\n  - AppLocker (3P):  %OSDRIVE%\\Users\\*\\AppData\\Local\\Claude-3p\\claude-code\\*\n  - AppLocker (1P):  %OSDRIVE%\\Users\\*\\AppData\\Roaming\\Claude\\claude-code\\*\n  - WDAC (3P):       %OSDRIVE%\\Users\\*\\AppData\\Local\\Claude-3p\\claude-code\\*\n  - WDAC (1P):       %OSDRIVE%\\Users\\*\\AppData\\Roaming\\Claude\\claude-code\\*\n    Note: WDAC ignores FilePath rules to user-writable locations unless the policy sets "Disabled:Runtime FilePath Rule Protection".\n\nIf Defender or other antivirus is blocking it, add an exclusion for the directory above or allow the detected item.'},cli_fastfail:{title:cIt.cliCrashed,body:dIt.tryAgainOrReport,retryHelps:!0},cli_shutdown_crash_benign:{title:cIt.interrupted,body:dIt.tryAgain,retryHelps:!0},dll_not_found:{title:cIt.dllNotFound,body:dIt.dllNotFound,retryHelps:!1},bun_crash:{title:cIt.cliCrashed,body:dIt.tryAgainOrReport,retryHelps:!0},auth_error:{title:cIt.signedOut,body:dIt.signIn,retryHelps:!1},github_auth:{title:cIt.githubAuth,body:dIt.githubAuth,retryHelps:!1},rate_limit:{title:cIt.rateLimit,body:dIt.rateLimit,retryHelps:!0},network_error:{title:cIt.network,body:dIt.network,retryHelps:!0},connection_refused:{title:cIt.connectionRefused,body:dIt.connectionRefused,retryHelps:!0},json_parse_error:{title:cIt.unexpectedOutput,body:dIt.restartApp,retryHelps:!0},filesystem_error:{title:cIt.diskError,body:dIt.diskError,retryHelps:!0},cli_stdout_pollution:{title:cIt.unexpectedOutput,body:dIt.unexpectedOutput,retryHelps:!1},cli_resume_not_found:{title:cIt.resumeNotFound,body:dIt.resumeNotFound,retryHelps:!0},stream_ended_no_result:{title:cIt.noResponse,body:dIt.tryAgain,retryHelps:!0},git_not_found:{title:cIt.gitRequired,body:dIt.gitRequired,retryHelps:!1},cwd_not_found:{title:cIt.folderNotFound,body:dIt.folderNotFound,retryHelps:!1},timeout:{title:cIt.noResponse,body:dIt.tryAgain,retryHelps:!0},trust_required:{title:cIt.trustRequired,body:dIt.trustRequired,retryHelps:!0},bun_cwd_eperm:{title:cIt.folderAccessDenied,body:dIt.folderAccessDenied,retryHelps:!1},os_too_old:{title:cIt.osTooOld,body:dIt.osTooOld,retryHelps:!1},claudecode_nested:{title:cIt.nestedSession,body:dIt.nestedSession,retryHelps:!1},bypass_permissions_gate_blocked:{title:cIt.bypassGateBlocked,body:dIt.bypassGateBlocked,retryHelps:!0},otel_cons
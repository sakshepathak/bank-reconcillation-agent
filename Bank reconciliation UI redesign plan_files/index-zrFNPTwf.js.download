nexpected output from Claude Code",id:"PvMfiitQFC"},trustRequired:{defaultMessage:"Workspace trust needed",id:"bx+Ne2nP0J"},nestedSession:{defaultMessage:"Nested session detected",id:"eCp7KgB6Nv"},bypassGateBlocked:{defaultMessage:"Bypass Permissions was blocked",id:"k7DhqlK9Ii"},otelExporter:{defaultMessage:"Telemetry config conflict",id:"QredwIagLx"},interrupted:{defaultMessage:"Session was interrupted",id:"1xdADWuuof"},bridgeOffline:{defaultMessage:"Remote Control disconnected",id:"SlaNB/mm2w"},sshDisconnected:{defaultMessage:"Lost connection to {host}",id:"x/AANGatCX"},rewindTargetNotFound:{defaultMessage:"Couldn't rewind",id:"qz07ubuWTz"},gitCheckoutFailed:{defaultMessage:"Couldn't switch branches",id:"5qlmjg4fJG"},remoteWorktreeFailed:{defaultMessage:"Couldn't set up remote folder",id:"yyIEWowL6r"},policyDenied:{defaultMessage:"Folder not allowed by your organization",id:"NxWkpRIOP4"},binaryLocked:{defaultMessage:"Locked by another program",id:"Jj5UsNkTxk"}}),dIt=G({tryAgain:{defaultMessage:"Try sending your message again.",id:"0hzmTPDdkC"},tryAgainOrReport:{defaultMessage:"Try sending your message again. If it keeps happening, share feedback so we can investigate.",id:"wSIy1+/HLg"},reinstall:{defaultMessage:"The Claude Code binary is missing or damaged. Reinstall Claude Desktop to continue.",id:"E9ffNa95kd"},reinstallArch:{defaultMessage:"The Claude Code binary doesn't match this computer's architecture. Reinstall Claude Desktop for your platform.",id:"hZ2DipvK2w"},restartApp:{defaultMessage:"Restarting Claude Desktop may resolve this.",id:"B6F2sC7pVE"},signIn:{defaultMessage:"Sign in again to continue.",id:"p0Vi703w32"},githubAuth:{defaultMessage:"Your GitHub credentials were rejected. Reconnect GitHub to continue.",id:"1HLmdzwR9I"},rateLimit:{defaultMessage:"You've reached your usage limit. Try again after your limit resets.",id:"HfMQVThKYy"},network:{defaultMessage:"Check your internet connection, VPN, or proxy and try again.",id:"Wb/3E+ALRw"},connectionRe
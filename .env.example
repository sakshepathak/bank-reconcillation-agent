# ── LLM Providers ─────────────────────────────────────────────────────────────
# Set provider to "anthropic" or "groq"
LLM_PROVIDER=groq

# Required for the selected provider:
ANTHROPIC_API_KEY=sk-ant-your-key-here
GROQ_API_KEY=gsk_your_key_here

# ── Agent Models ──────────────────────────────────────────────────────────────
# Default for Groq: llama-3.3-70b-versatile
# Default for Anthropic: claude-3-5-sonnet-20241022
AGENT_MODEL=llama-3.3-70b-versatile

# ── Embedding Models (local via fastembed — no API key required) ──────────────
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25

# ── Retrieval Tuning ──────────────────────────────────────────────────────────
HYBRID_TOP_K=20
RERANK_TOP_K=5

# ── Matching Engine Tolerances ────────────────────────────────────────────────
# Absolute amount tolerance for fuzzy amount matching (in your currency units)
AMOUNT_TOLERANCE=0.05
# Date window (days) for fuzzy date matching
DATE_WINDOW_DAYS=3
# Minimum description similarity score (0-100) for Level 3 matching
FUZZY_SCORE_THRESHOLD=80

# ── Database (swap to PostgreSQL URL for production) ─────────────────────────
DATABASE_URL=sqlite:///./bank_recon.db
# Postgres example: DATABASE_URL=postgresql://user:password@localhost:5432/bank_recon

# ── Observability (optional) ──────────────────────────────────────────────────
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_PROJECT=bank-reconciliation-agent
